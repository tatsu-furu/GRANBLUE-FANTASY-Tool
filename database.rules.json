{
  "rules": {
    ".read": false,
    ".write": false,
    "locks": {
      "$room": {
        ".read": false,
        ".write": "auth != null && root.child('rooms').child($room).child('meta/owner').val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Za-z0-9]{20}$/) && (!root.child('locks').child($room).exists() || data.child('members').child(auth.uid).val() === root.child('locks').child($room).val())",
        ".write": "auth != null && $room.matches(/^[A-Za-z0-9]{20}$/) && (!root.child('locks').child($room).exists() || data.child('members').child(auth.uid).val() === root.child('locks').child($room).val()) && (newData.exists() || data.child('meta/owner').val() === auth.uid)",
        ".validate": "newData.child('meta/createdAt').exists()",
        "meta": {
          ".validate": "newData.hasChild('createdAt') && (!data.child('owner').exists() || newData.child('owner').val() === data.child('owner').val())",
          "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "owner": { ".validate": "(!data.exists() && newData.val() === auth.uid) || data.val() === newData.val()" },
          "locked": { ".validate": "newData.isBoolean()" }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room.matches(/^[A-Za-z0-9]{20}$/)",
            ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('locks').child($room).val()"
          }
        },
        "move": {
          "setup": {
            "weaponImageBase64": { ".validate": "newData.isString() && newData.val().length < 1500000" },
            "characterIcons": { "$i": { ".validate": "newData.isString() && newData.val().length < 60000" } }
          }
        },
        "sheets": {
          "$sheet": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "rows": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500" },
            "cols": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 52" },
            "cells": {
              "$cell": { ".validate": "$cell.matches(/^[0-9]{1,3}_[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 2000" }
            }
          }
        },
        "shots": {
          "$shot": {
            ".validate": "newData.hasChildren(['title', 'at'])",
            "title": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "thumb": { ".validate": "newData.isString() && newData.val().length < 100000" }
          }
        },
        "shotData": {
          "$shot": { ".validate": "newData.isString() && newData.val().length < 1500000" }
        },
        "presence": {
          "$client": { ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 32" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
