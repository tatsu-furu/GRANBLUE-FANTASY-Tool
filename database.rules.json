{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[A-Za-z0-9]{20}$/)",
        ".write": "$room.matches(/^[A-Za-z0-9]{20}$/)",
        "meta": {
          ".validate": "newData.hasChild('createdAt')"
        },
        "move": {
          "setup": {
            "weaponImageBase64": { ".validate": "newData.isString() && newData.val().length < 1500000" },
            "characterIcons": { "$i": { ".validate": "newData.isString() && newData.val().length < 60000" } }
          }
        },
        "sheets": {
          "$sheet": {
            "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "rows": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500" },
            "cols": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 52" },
            "cells": {
              "$cell": { ".validate": "$cell.matches(/^[0-9]{1,3}_[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 2000" }
            }
          }
        },
        "presence": {
          "$client": { ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 32" }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
