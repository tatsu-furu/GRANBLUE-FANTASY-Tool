{
  "rules": {
    ".read": false,
    ".write": false,
    "admin": {
      ".read": "(auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')"
    },
    "locks": {
      "$room": {
        ".read": false,
        ".write": "(auth != null && root.child('rooms').child($room).child('meta/owner').val() === auth.uid) || (auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    "roomIndex": {
      ".read": "(auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')",
      "$room": {
        ".write": "(auth != null && $room.matches(/^[A-Za-z0-9]{20}$/) && (!root.child('locks').child($room).exists() || root.child('rooms').child($room).child('members').child(auth.uid).val() === root.child('locks').child($room).val())) || (auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')",
        ".validate": "newData.hasChild('createdAt')",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "openedAt": {
          ".validate": "newData.isNumber()"
        },
        "locked": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "(auth != null && $room.matches(/^[A-Za-z0-9]{20}$/) && (!root.child('locks').child($room).exists() || data.child('members').child(auth.uid).val() === root.child('locks').child($room).val())) || (auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')",
        ".write": "((auth != null && $room.matches(/^[A-Za-z0-9]{20}$/) && (!root.child('locks').child($room).exists() || data.child('members').child(auth.uid).val() === root.child('locks').child($room).val())) && (newData.exists() || data.child('meta/owner').val() === auth.uid)) || (auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')",
        ".validate": "newData.child('meta/createdAt').exists()",
        "meta": {
          ".validate": "newData.hasChild('createdAt') && (!data.child('owner').exists() || newData.child('owner').val() === data.child('owner').val())",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "owner": {
            ".validate": "(!data.exists() && newData.val() === auth.uid) || data.val() === newData.val()"
          },
          "locked": {
            ".validate": "newData.isBoolean()"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room.matches(/^[A-Za-z0-9]{20}$/)",
            ".validate": "newData.isString() && newData.val() === newData.parent().parent().parent().parent().child('locks').child($room).val()"
          }
        },
        "move": {
          "setup": {
            "weaponImageBase64": {
              ".validate": "newData.isString() && newData.val().length < 1500000"
            },
            "characterIcons": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length < 60000"
              }
            }
          }
        },
        "sheets": {
          "$sheet": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "rows": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
            },
            "cols": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 52"
            },
            "cells": {
              "$cell": {
                ".validate": "$cell.matches(/^[0-9]{1,3}_[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 2000"
              }
            }
          }
        },
        "shots": {
          "$shot": {
            ".validate": "newData.hasChildren(['title', 'at'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "thumb": {
              ".validate": "newData.isString() && newData.val().length < 100000"
            }
          }
        },
        "shotData": {
          "$shot": {
            ".validate": "newData.isString() && newData.val().length < 1500000"
          }
        },
        "presence": {
          "$client": {
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 32"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reminders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "(auth != null && auth.uid === $uid) || (auth != null && auth.token.email_verified === true && auth.token.email === 'ADMIN_EMAIL@example.com')",
        "$id": {
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{6,30}$/) && newData.hasChildren(['webhook', 'content', 'repeat', 'nextAt', 'enabled', 'createdAt'])",
          "webhook": {
            ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/(ptb\\.|canary\\.)?(discord|discordapp)\\.com\\/api\\/webhooks\\/[0-9]{17,20}\\/[A-Za-z0-9_-]{20,}$/)"
          },
          "content": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1800"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "username": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "mention": {
            ".validate": "newData.isString() && newData.val().matches(/^(none|everyone|here|role:[0-9]{17,20})$/)"
          },
          "repeat": {
            ".validate": "newData.isString() && newData.val().matches(/^(none|daily|weekly)$/)"
          },
          "nextAt": {
            ".validate": "newData.isNumber()"
          },
          "startAt": {
            ".validate": "newData.isNumber()"
          },
          "endAt": {
            ".validate": "newData.isNumber()"
          },
          "enabled": {
            ".validate": "newData.isBoolean()"
          },
          "done": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "lastSentAt": {
            ".validate": "newData.isNumber()"
          },
          "lastError": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "reminderQueue": {
      ".indexOn": [
        "nextAt"
      ],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || (newData.child('uid').val() === auth.uid && newData.parent().parent().child('reminders').child(auth.uid).child($id).exists()))",
        ".validate": "newData.hasChildren(['uid', 'nextAt'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "nextAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reminderStatus": {
      ".read": true
    }
  }
}
