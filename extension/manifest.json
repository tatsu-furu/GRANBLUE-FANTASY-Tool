{
  "manifest_version": 3,
  "name": "GBF Tool Split View",
  "version": "2.5",
  "description": "グラブルツールサイトで攻略サイトを内蔵ブラウザ / Side Panel / Chrome Split Viewで横並び表示する拡張機能",
  "permissions": ["tabs", "windows", "declarativeNetRequest", "declarativeNetRequestFeedback", "debugger", "sidePanel", "storage"],
  "host_permissions": [
    "*://*.gamewith.jp/*",
    "*://kamigame.jp/*",
    "*://www.youtube.com/*",
    "*://*.alt4l.dev/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "*://*.alt4l.dev/*",
      "*://localhost/*",
      "*://127.0.0.1/*"
    ]
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "remove_frame_headers",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "content_scripts": [
    {
      "matches": ["*://*.gamewith.jp/*"],
      "js": ["anti-framebust.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.gamewith.jp/*"],
      "js": ["content-diag.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "GBF Tool Split View"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
