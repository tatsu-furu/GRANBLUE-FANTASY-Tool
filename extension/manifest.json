{
  "manifest_version": 3,
  "name": "GBF Tool Split View",
  "version": "2.0",
  "description": "グラブルツールサイトで攻略サイトを内蔵ブラウザ / Chrome Split Viewで横並び表示する拡張機能",
  "permissions": ["tabs", "windows", "declarativeNetRequest"],
  "host_permissions": [
    "*://*.gamewith.jp/*",
    "*://kamigame.jp/*",
    "*://www.youtube.com/*",
    "*://*.alt4l.dev/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "*://*.alt4l.dev/*",
      "*://localhost/*",
      "*://127.0.0.1/*"
    ]
  },
  "declarative_net_request": {
    "rule_resources": [{
      "id": "remove_frame_headers",
      "enabled": true,
      "path": "rules.json"
    }]
  },
  "action": {
    "default_title": "GBF Tool Split View"
  }
}
